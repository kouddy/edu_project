# Bootstrap image for the compose `supabase` service: the Supabase CLI
# plus a Docker client. The CLI starts the local Supabase stack as
# sibling containers through the host's Docker socket — the stack is a
# local development dependency, not something this project hosts.
# Matches the supabase devDependency version in package.json.
FROM docker:27-cli

ARG SUPABASE_CLI_VERSION=2.122.1
RUN apk add --no-cache curl tar gzip ca-certificates && \
    case "$(uname -m)" in \
      x86_64) ARCH=amd64 ;; \
      aarch64|arm64) ARCH=arm64 ;; \
      *) echo "unsupported architecture: $(uname -m)" && exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/supabase/cli/releases/download/v${SUPABASE_CLI_VERSION}/supabase_${SUPABASE_CLI_VERSION}_linux_${ARCH}.tar.gz" \
      | tar -xz -C /usr/local/bin supabase && \
    supabase --version

WORKDIR /project
