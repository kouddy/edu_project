# Bootstrap image for the compose `supabase` service: the Supabase CLI,
# which starts the local Supabase stack as sibling containers through
# the host's Docker socket. The stack is a local development
# dependency, not something this project hosts.
# Matches the supabase devDependency version in package.json.
#
# The base is Debian (glibc) on purpose: the CLI's main binary is
# dynamically linked against glibc, so on an Alpine (musl) base it
# fails with a misleading "supabase: not found". A Docker client is
# installed alongside: the CLI drives most of the stack through the
# Docker API, but it shells out to `docker` for container health
# checks, and fails without it.
FROM debian:bookworm-slim

ARG SUPABASE_CLI_VERSION=2.122.1
ARG DOCKER_CLI_VERSION=27.5.1
RUN apt-get update && apt-get install -y --no-install-recommends curl tar gzip ca-certificates && \
    case "$(uname -m)" in \
      x86_64) ARCH=amd64 ;; \
      aarch64|arm64) ARCH=arm64 ;; \
      *) echo "unsupported architecture: $(uname -m)" && exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/supabase/cli/releases/download/v${SUPABASE_CLI_VERSION}/supabase_${SUPABASE_CLI_VERSION}_linux_${ARCH}.tar.gz" \
      | tar -xz -C /usr/local/bin supabase supabase-go && \
    curl -fsSL "https://download.docker.com/linux/static/stable/$(uname -m)/docker-${DOCKER_CLI_VERSION}.tgz" \
      | tar -xz -C /usr/local/bin --strip-components=1 docker/docker && \
    rm -rf /var/lib/apt/lists/* && \
    supabase --version && docker --version

WORKDIR /project
