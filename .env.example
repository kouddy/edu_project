# Vision model used to analyze sheets
META_API_KEY=
GRADING_PROVIDER=meta

# Real accounts (Supabase). Leave all three unset to run without live
# accounts — the app then offers only the demo and guest modes.
# For local development, start the local stack (`npm run supabase:start`)
# and copy the API URL and keys it prints into the values below.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
