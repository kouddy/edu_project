META_API_KEY=
BASETEN_API_KEY=
MODAL_API_KEY=
GEMINI_API_KEY=

# Vision model to use for grading.
GRADING_PROVIDER=meta
GRADING_MODEL=muse-spark-1.3-contributor
# Guidance animation generation.
GUIDANCE_PROVIDER=meta
GUIDANCE_MODEL=muse-spark-1.3-contributor
# Guidance images: the image model id (provider is the image block in subjects.json).
IMAGE_MODEL=muse-image-1.0

# Real accounts stored in Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_API_KEY=

# Local containers (compose.yaml): Supabase runs as the CLI's local
# stack, whose standard demo keys are inlined in compose.yaml itself —
# nothing to set here for it. The provider keys above are passed
# through to the app container when they are set in .env.
