# Vision model (Meta Muse Spark 1.3, OpenAI-compatible chat completions).
# Leave URL/KEY unset for demo mode (all items return unsure).
# URL accepts the base URL or the full endpoint (either works).
MUSE_SPARK_API_URL=https://api.meta.ai/v1/chat/completions
MUSE_SPARK_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3

# Secret for signing private photo URLs (short-lived). Set a random value in real use.
PHOTO_URL_SECRET=dev-only-secret-change-me
