META_API_KEY=
BASETEN_API_KEY=
MODAL_API_KEY=
GEMINI_API_KEY=

# Vision model to use for grading.
GRADING_PROVIDER=meta
GRADING_MODEL=muse-spark-1.3-contributor

# Guidance animation generation.
GUIDANCE_PROVIDER=baseten
GUIDANCE_MODEL=meta-models/muse-spark-open-1026
# Guidance images: the image model id (provider is the image block in subjects.json).
IMAGE_MODEL=muse-image-1.0

# Real accounts (Supabase). Leave both unset to run without live
# accounts — the app then offers demo mode only, with no live sign-in.
# For local development, start the local stack (`npm run supabase:start`)
# and copy the API URL and publishable key it prints into the values
# below. No secret/service-role key is needed: the server verifies the
# parent's token and every account query runs as that parent, scoped
# by row-level security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_API_KEY=
